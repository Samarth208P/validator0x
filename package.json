        "default": "./dist/litecoin.cjs"
      }
    },
    "./dogecoin": {
      "import": {
        "types": "./dist/dogecoin.d.mts",
        "default": "./dist/dogecoin.mjs"
      },
      "require": {
        "types": "./dist/dogecoin.d.cts",
        "default": "./dist/dogecoin.cjs"
      }
    },
    "./solana": {
      "import": {
        "types": "./dist/solana.d.mts",
        "default": "./dist/solana.mjs"
      },
      "require": {
        "types": "./dist/solana.d.cts",
        "default": "./dist/solana.cjs"
      }
    },
    "./ripple": {
      "import": {
        "types": "./dist/ripple.d.mts",
        "default": "./dist/ripple.mjs"
      },
      "require": {
        "types": "./dist/ripple.d.cts",
        "default": "./dist/ripple.cjs"
      }
    },
    "./cardano": {
      "import": {
        "types": "./dist/cardano.d.mts",
        "default": "./dist/cardano.mjs"
      },
      "require": {
        "types": "./dist/cardano.d.cts",
        "default": "./dist/cardano.cjs"
      }
    },
    "./tron": {
      "import": {
        "types": "./dist/tron.d.mts",
        "default": "./dist/tron.mjs"
      },
      "require": {
        "types": "./dist/tron.d.cts",
        "default": "./dist/tron.cjs"
      }
    },
    "./cosmos": {
      "import": {
        "types": "./dist/cosmos.d.mts",
        "default": "./dist/cosmos.mjs"
      },
      "require": {
        "types": "./dist/cosmos.d.cts",
        "default": "./dist/cosmos.cjs"
      }
    },
    "./move": {
      "import": {
        "types": "./dist/move.d.mts",
        "default": "./dist/move.mjs"
      },
      "require": {
        "types": "./dist/move.d.cts",
        "default": "./dist/move.cjs"
      }
    },
    "./near": {
      "import": {
        "types": "./dist/near.d.mts",
        "default": "./dist/near.mjs"
      },
      "require": {
        "types": "./dist/near.d.cts",
        "default": "./dist/near.cjs"
      }
    },
    "./formatters": {
      "import": {
        "types": "./dist/formatters.d.mts",
        "default": "./dist/formatters.mjs"
      },
      "require": {
        "types": "./dist/formatters.d.cts",
        "default": "./dist/formatters.cjs"
      }
    },
    "./package.json": "./package.json",
    "./AGENTS.md": "./AGENTS.md"
  },
  "typesVersions": {
    "*": {
      "ethereum": [
        "./dist/ethereum.d.cts"
      ],
      "evm": [
        "./dist/evm.d.cts"
      ],
      "bitcoin": [
        "./dist/bitcoin.d.cts"
      ],
      "litecoin": [
        "./dist/litecoin.d.cts"
      ],
      "dogecoin": [
        "./dist/dogecoin.d.cts"
      ],
      "solana": [
        "./dist/solana.d.cts"
      ],
      "ripple": [
        "./dist/ripple.d.cts"
      ],
      "cardano": [
        "./dist/cardano.d.cts"
      ],
      "tron": [
        "./dist/tron.d.cts"
      ],
      "cosmos": [
        "./dist/cosmos.d.cts"
      ],
      "move": [
        "./dist/move.d.cts"
      ],
      "near": [
        "./dist/near.d.cts"
      ],
      "formatters": [
        "./dist/formatters.d.cts"
      ]
    }
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  }
}
