{
  "name": "validator0x",
  "version": "0.3.0",
  "description": "Lightweight, zero-dependency wallet address validation for EVM, Bitcoin, Solana, TRON, Cosmos, Cardano, Sui, Aptos, NEAR and more.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samarth208P/validator0x.git"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && rollup -c && node scripts/declarations.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "test:differential": "node scripts/test-differential.mjs",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:differential && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "prepare:release": "npm run check && npm run test:coverage && npm audit && npm pack --ignore-scripts"
  },
  "keywords": [
    "blockchain",
    "wallet",
    "address",
    "validator",
    "ethereum",
    "solana",
    "bitcoin",
    "polygon",
    "litecoin",
    "dogecoin",
    "cardano",
    "ripple",
    "evm",
    "web3",
    "crypto",
    "batch-validation",
    "checksum",
    "validator0x",
    "tron",
    "cosmos",
    "sui",
    "aptos",
    "near",
    "osmosis",
    "celestia"
  ],
  "author": "Samarth Patel",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.3",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "@rollup/plugin-terser": "^1.0.2",
    "rollup-plugin-dts": "^6.5.1",
    "typescript-eslint": "^8.72.2",
    "@eslint/js": "^10.0.1",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  },
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ethereum": {
      "import": {
        "types": "./dist/ethereum.d.mts",
        "default": "./dist/ethereum.mjs"
      },
      "require": {
        "types": "./dist/ethereum.d.cts",
        "default": "./dist/ethereum.cjs"
      }
    },
    "./evm": {
      "import": {
        "types": "./dist/evm.d.mts",
        "default": "./dist/evm.mjs"
